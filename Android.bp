android_app {
    name: "GameBar",
    defaults: [
        "SettingsLibDefaults",
    ],

    srcs: [
        "src/**/*.kt",
        "src/**/*.java"
    ],

    certificate: "platform",
    resource_dirs: ["res"],
    platform_apis: true,
    system_ext_specific: true,
    privileged: true,

    static_libs: [
        "androidx.core_core",
       // "org.lineageos.settings.resources",
    ],

//    optimize: {
//        proguard_flags_files: ["proguard.flags"],
//    },

      required: [
            "gamebar_init",
      ]

//    required: [
//        "privapp_whitelist_mx.xperience.gamebar.xml",
//    ],
}

